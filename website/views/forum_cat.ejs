<%- include('partials/head') %>
<div class="dc-page">
  <p><a href="/forum" class="muted">← All categories</a></p>
  <h1 class="dc-title" style="margin-top:10px"><%= cat.name %></h1>
  <p class="muted" style="margin-bottom:24px"><%= cat.desc %></p>

  <% if (user) { %>
    <div class="card" style="margin-bottom:24px">
      <h3>New topic</h3>
      <form method="POST" action="/forum/<%= cat.id %>/new">
        <div class="form-row"><input type="text" name="title" placeholder="Topic title" required></div>
        <div class="form-row"><textarea name="body" placeholder="Write the first post…"></textarea></div>
        <button class="btn btn-accent">Create topic</button>
      </form>
    </div>
  <% } else { %>
    <p class="muted" style="margin-bottom:24px"><a href="/login">Log in</a> to start a topic.</p>
  <% } %>

  <div class="dc-table">
    <% if (!posts.length) { %><div class="muted" style="padding:18px 16px">No topics in this category yet.</div><% } %>
    <% posts.slice().sort((a,b)=>(b.at||0)-(a.at||0)).forEach(function(p){
      var u = (typeof usersMap !== 'undefined' && usersMap) ? usersMap[p.uid] : null;
      var rc = (typeof replyCounts !== 'undefined' && replyCounts) ? (replyCounts[p.id] || 0) : 0;
    %>
      <div class="dc-topic" onclick="location.href='/forum/thread/<%= p.id %>'" style="cursor:pointer">
        <div>
          <div class="tt"><a href="/forum/thread/<%= p.id %>"><%= p.title %></a></div>
          <div class="muted" style="font-size:var(--fs08);margin-top:4px">by <%= u ? u.username : 'user' %></div>
        </div>
        <div class="dc-num"><b><%= rc %></b>replies</div>
        <div class="dc-num"><b><%= p.views || 0 %></b>views</div>
        <div class="dc-act"><%= new Date(p.at).toLocaleDateString() %></div>
      </div>
    <% }) %>
  </div>
</div>
<%- include('partials/foot') %>
