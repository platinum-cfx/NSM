<%- include('partials/head') %>
<div class="mp-head">
  <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:14px;flex-wrap:wrap">
    <div>
      <h1>Marketplace</h1>
      <p>Scripts, vehicles, maps and more — made by the GTAMP community.</p>
    </div>
    <% if (user) { %><a href="/keymaster" class="btn btn-accent">Publish an asset</a><% } %>
  </div>
</div>
<div class="mp-rail">
  <% var pics = { car: '🚗', script: '📜', map: '🗺', weapon: '🔫', clothing: '👕', misc: '📦' }; %>
  <% if (!assets.length) { %>
    <div class="muted" style="padding:30px 0">No assets published yet. Be the first — publish from your <a href="/keymaster">Keymaster</a>.</div>
  <% } %>
  <div class="mp-grid">
    <% assets.forEach(function(a, i){
      var seller = (typeof usersMap !== 'undefined' && usersMap && usersMap[a.ownerId]) ? usersMap[a.ownerId].username : (a.author || 'Creator');
    %>
      <div class="mp-card" onclick="location.href='/marketplace/<%= a.id %>'" style="cursor:pointer">
        <div class="mp-pic p<%= (i % 6) + 1 %>"><%= pics[a.cat] || '📦' %></div>
        <div class="mp-info">
          <div class="mp-name"><%= a.title %> <span class="vf" title="Verified publisher">✔</span></div>
          <div class="mp-seller">by <%= seller %> · <span class="tag"><%= a.cat %></span></div>
          <div class="mp-foot">
            <span class="<%= a.price > 0 ? 'mp-price' : 'mp-price free' %>"><%= a.price > 0 ? '$' + Number(a.price).toFixed(2) : 'FREE' %></span>
            <span class="mp-dl">⬇ <%= a.downloads || 0 %></span>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>
<%- include('partials/foot') %>
