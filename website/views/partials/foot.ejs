<script>
(function(){
  var bo=document.getElementById('burger-open'),bm=document.getElementById('burger-menu'),bc=document.getElementById('burger-close');
  if(bo&&bm){bo.addEventListener('click',function(){bm.classList.add('active');document.body.classList.add('disable-scroll')});}
  if(bc&&bm){bc.addEventListener('click',function(){bm.classList.remove('active');document.body.classList.remove('disable-scroll')});}
  var dl=document.getElementById('dl');
  if(dl){dl.addEventListener('click',function(){
    var s=document.getElementById('hero-seller'),t=document.getElementById('hero-thanks');
    if(s&&t){s.classList.add('faded');t.classList.add('active');}
  });}
})();
</script>
