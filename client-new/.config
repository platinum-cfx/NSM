

gta_path = ''

# Masterlist used by the server browser (run connect.exe with no arguments to open it)
masterlist_url = 'http://127.0.0.1:8080'

# Show the game inside the NSM window (false = GTA V opens in its own window).
# The NSM window only appears once the game window is actually embedded.
embed_game_window = true

# Seconds to wait for GTA V to start after the client is launched
# (timeout -> clear error, client closed, back to the browser)
game_start_timeout_sec = 120

# Seconds to wait for the game window to be embedded into the NSM window
# (timeout -> the game continues in its own window, logged)
embed_timeout_sec = 90

[gtamp-hidden-options]
debug = true

[voice]
activation_key = 78
sensitivity = 20
volume = 100

[voice.options]
enabled = true
activation_enabled = false
auto_input_volume = true
input_volume = true
noise_suppression = true
auto_find_mic = true
input_device = 'default'
input_normalization = true
