

gta_path = ''

# Masterlist used by the server browser (run connect.exe with no arguments to open it)
masterlist_url = 'http://127.0.0.1:8080'

[gtamp-hidden-options]
debug = true

[voice]
activation_key = 78
sensitivity = 20
volume = 100

[voice.options]
enabled = true
activation_enabled = false
auto_input_volume = true
input_volume = true
noise_suppression = true
auto_find_mic = true
input_device = 'default'
input_normalization = true
